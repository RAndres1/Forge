{
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "ai-coach": {
      "root": "services/ai-coach"
    }
  },
  "rewrites": [
    {
      "source": "/api/ai-coach(/.*)?",
      "destination": {
        "type": "service",
        "service": "ai-coach"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
